# macOS
.DS_Store
._*

# Windows
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
.idea/
*.swp

# Fichiers de travail
*.ai
*.psd
*.indd
_a-traiter/

# Sortie de build.sh, reconstruite a chaque deploiement.
dist/

# Listes de prospects produites par outils/veille-entreprises.py.
# Elles contiennent des noms et des adresses de personnes physiques :
# elles n'ont rien à faire dans l'historique d'un dépôt, qui ne s'oublie
# jamais. L'outil les régénère en une minute.
outils/prospects/
__pycache__/
*.pyc

# Squelettes de calendrier régénérés par reseaux/calendrier.py.
reseaux/calendrier-*.csv
reseaux/*-squelette.md

# Aperçus HTML régénérés par reseaux/envoyer-propositions.py --essai.
reseaux/propositions/*-apercu.html

# Visuels produits par reseaux/visuels.py. Ils se régénèrent en deux
# secondes à partir du script : les versionner alourdirait le dépôt sans
# rien apporter.
reseaux/visuels/
.dev.vars
.wrangler/
node_modules/
package.json
package-lock.json
