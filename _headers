# En-tetes servis par Cloudflare Pages.
# Syntaxe : un chemin, puis les en-tetes indentes de deux espaces.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
  # Meme politique que la balise <meta> des pages, mais en vrai en-tete :
  # la directive frame-ancestors est ignoree quand elle vient d'une balise.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Polices : nom stable mais contenu fige, cache long.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fa/webfonts/*
  Cache-Control: public, max-age=31536000, immutable

# Les images changent de nom quand elles changent : cache long.
# Le CSS et le JS gardent le meme nom : cache court, sinon une correction
# mettrait des jours a atteindre les visiteurs.
/assets/img/*
  Cache-Control: public, max-age=2592000
